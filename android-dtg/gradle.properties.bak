# Project-wide Gradle settings.

# AndroidX package structure
android.useAndroidX=true
android.enableJetifier=true

# Kotlin code style
kotlin.code.style=official

# Performance optimization (increased for 1.6GB model assets)
org.gradle.jvmargs=-Xmx6144m -XX:MaxMetaspaceSize=1024m -XX:+HeapDumpOnOutOfMemoryError -Dfile.encoding=UTF-8
org.gradle.daemon=true
org.gradle.parallel=true
org.gradle.configureondemand=true
org.gradle.caching=true

# Build features
android.defaults.buildfeatures.buildconfig=true
android.nonTransitiveRClass=false
android.nonFinalResIds=false

# JDK path for Android Gradle Plugin 8.2.0 (requires Java 11+)
org.gradle.java.home=C:\\Program Files\\Microsoft\\jdk-17.0.17.10-hotspot